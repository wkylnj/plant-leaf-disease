# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.ipynb_checkpoints/
*.egg-info/
.pytest_cache/

# ===== 数据（体积大，绝不提交）=====
# ml/data 有 2.37GB：raw 812MB parquet + processed 1.57GB jpg
ml/data/
!ml/data/.gitkeep

# ===== 训练产物 =====
# 权重文件动辄几十到几百 MB，不提交
**/*.pt
**/*.pth
**/*.onnx
**/*.npz
**/*.ckpt

# 冒烟测试的产物，临时性质
runs_smoke/

# 注意：runs/ 下的 summary.json / history.csv / config.json 要提交
# 它们是实验记录，报告里的每个数字都要能追溯到某次运行

# ===== 安卓 =====
# 注意：Gradle 根目录在 app/ 下，模块也叫 app，所以构建产物实际在 app/app/build/
app/.gradle/
# 在 app/ 目录下跑 gradle 时，有时会在仓库根留下一份 .gradle/
/.gradle/
app/build/
app/app/build/
app/.kotlin/
app/.cxx/
app/local.properties
*.apk
*.aab
*.jks
*.keystore
app/captures/

# ===== 服务端 =====
server/*.db
server/app.db
# SQLite WAL 模式的临时文件，每次开关服务都会变，不该进版本库
server/*.db-shm
server/*.db-wal
server/uploads/
server/__pycache__/
.env
.env.*

# ===== 系统与编辑器 =====
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# ===== 本机临时文件 =====
# ACL 修复的备份，与项目无关
_acl-recovery/
*.log

# Grad-CAM per-sample overlays (grid.png is tracked, individual overlays are not)
**/gradcam/overlay_*.png

# ===== Kaggle 产物下载的临时目录 =====
_kaggle_out/
# Kaggle OAuth 凭据与本地登录脚本的临时文件
_colab_code.txt
_colab_login*.log
_colab_login*.err
# 忽略临时探测脚本与冒烟产物
_*.png
scripts/_probe_*.py
ml/tmp/
ml/runs/smoke_*/
ml/runs/_fbr_smoke/
ml/data/raw/plantdoc_bg/
ml/data/processed/pv_fbr/
ml/data/processed/pv_fbr_smoke/
ml/artifacts/calibration_cache/
